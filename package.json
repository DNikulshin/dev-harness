{
  "name": "@dnikulshin/harness",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=26.13 <27"
  },
  "files": [
    "scripts/",
    "types/",
    "templates/",
    "docs/",
    "README.md"
  ],
  "exports": {
    "./scripts/check-harness": {
      "types": "./types/check-harness.d.mts",
      "default": "./scripts/check-harness.mjs"
    },
    "./scripts/cycle-decide": {
      "types": "./types/cycle-decide.d.mts",
      "default": "./scripts/cycle-decide.mjs"
    },
    "./scripts/cycle-driver": {
      "types": "./types/cycle-driver.d.mts",
      "default": "./scripts/cycle-driver.mjs"
    },
    "./scripts/cycle-evidence": {
      "types": "./types/cycle-evidence.d.mts",
      "default": "./scripts/cycle-evidence.mjs"
    },
    "./scripts/cycle-gates": {
      "types": "./types/cycle-gates.d.mts",
      "default": "./scripts/cycle-gates.mjs"
    },
    "./scripts/cycle-metrics": {
      "types": "./types/cycle-metrics.d.mts",
      "default": "./scripts/cycle-metrics.mjs"
    },
    "./scripts/cycle-pr-body": {
      "types": "./types/cycle-pr-body.d.mts",
      "default": "./scripts/cycle-pr-body.mjs"
    },
    "./scripts/cycle-report": {
      "types": "./types/cycle-report.d.mts",
      "default": "./scripts/cycle-report.mjs"
    },
    "./scripts/cycle-state": {
      "types": "./types/cycle-state.d.mts",
      "default": "./scripts/cycle-state.mjs"
    },
    "./scripts/cycle-usage": {
      "types": "./types/cycle-usage.d.mts",
      "default": "./scripts/cycle-usage.mjs"
    },
    "./scripts/lib/cycle/config": {
      "types": "./types/lib/cycle/config.d.mts",
      "default": "./scripts/lib/cycle/config.mjs"
    },
    "./scripts/evals-collect": {
      "types": "./types/evals-collect.d.mts",
      "default": "./scripts/evals-collect.mjs"
    },
    "./scripts/evals-cost": {
      "types": "./types/evals-cost.d.mts",
      "default": "./scripts/evals-cost.mjs"
    },
    "./scripts/evals-pack": {
      "types": "./types/evals-pack.d.mts",
      "default": "./scripts/evals-pack.mjs"
    },
    "./scripts/evals-score": {
      "types": "./types/evals-score.d.mts",
      "default": "./scripts/evals-score.mjs"
    },
    "./scripts/harness-init": {
      "types": "./types/harness-init.d.mts",
      "default": "./scripts/harness-init.mjs"
    },
    "./scripts/selftest": {
      "types": "./types/selftest.d.mts",
      "default": "./scripts/selftest.mjs"
    },
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "harness-check-layout": "./scripts/check-harness.mjs",
    "harness-cycle-decide": "./scripts/cycle-decide.mjs",
    "harness-cycle-driver": "./scripts/cycle-driver.mjs",
    "harness-cycle-evidence": "./scripts/cycle-evidence.mjs",
    "harness-cycle-gates": "./scripts/cycle-gates.mjs",
    "harness-cycle-metrics": "./scripts/cycle-metrics.mjs",
    "harness-cycle-pr-body": "./scripts/cycle-pr-body.mjs",
    "harness-cycle-report": "./scripts/cycle-report.mjs",
    "harness-cycle-state": "./scripts/cycle-state.mjs",
    "harness-cycle-usage": "./scripts/cycle-usage.mjs",
    "harness-evals-collect": "./scripts/evals-collect.mjs",
    "harness-evals-cost": "./scripts/evals-cost.mjs",
    "harness-evals-pack": "./scripts/evals-pack.mjs",
    "harness-evals-score": "./scripts/evals-score.mjs",
    "harness-init": "./scripts/harness-init.mjs",
    "harness-selftest": "./scripts/selftest.mjs"
  },
  "scripts": {
    "test": "node --test",
    "rag:sync": "node tooling/rag-sync.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:types": "tsc -p tsconfig.build.json",
    "typecheck:types:check": "pnpm typecheck:types && test -z \"$(git status --porcelain --untracked-files=all types)\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node --test && tsc -p tsconfig.json && prettier --check .",
    "board:sync": "node tooling/board-sync.mjs",
    "board:sync:dry": "DRY_RUN=1 node tooling/board-sync.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "precommit": "node tooling/precommit.mjs",
    "git:hygiene": "node tooling/git-hygiene.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
