{
  "provider": "polza-ai/",
  "gates": [
    {
      "id": "test",
      "executable": "node",
      "args": ["--test"],
      "required": true,
      "dependsOn": [],
      "pathPrefixes": [],
      "env": {}
    },
    {
      "id": "typecheck",
      "executable": "pnpm",
      "args": ["exec", "tsc", "-p", "tsconfig.json"],
      "required": true,
      "dependsOn": [],
      "pathPrefixes": [],
      "env": {}
    },
    {
      "id": "check_harness",
      "executable": "node",
      "args": ["scripts/check-harness.mjs"],
      "required": true,
      "dependsOn": [],
      "pathPrefixes": [".pi/", "templates/", "AGENTS.md", "scripts/check-harness.mjs"],
      "env": {}
    },
    {
      "id": "secrets_scan",
      "builtin": "secrets_scan",
      "required": true,
      "dependsOn": [],
      "pathPrefixes": []
    },
    {
      "id": "format_check",
      "executable": "pnpm",
      "args": ["exec", "prettier", "--check", "."],
      "required": true,
      "dependsOn": [],
      "pathPrefixes": [],
      "env": {}
    }
  ],
  "limits": {
    "maxDiffLines": 2000,
    "maxDiffBytes": 409600,
    "logMaxBytes": 5242880,
    "evidenceTailLines": 200,
    "defaultMaxIterations": 2,
    "maxCycleCostRub": 30
  },
  "paths": {
    "prTemplate": ".github/PULL_REQUEST_TEMPLATE.md"
  },
  "gateTimeouts": {
    "test": 600000,
    "format_check": 120000,
    "typecheck": 180000,
    "check_harness": 120000,
    "secrets_scan": 60000
  },
  "integrity": {
    "testPaths": ["**/*.test.mjs"],
    "protectedPaths": [".pi/harness.config.json", ".pi/agents", "AGENTS.md"]
  }
}
