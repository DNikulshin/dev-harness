{
  "provider": "polza-ai/",
  "gates": [
    {
      "id": "test",
      "executable": "node",
      "args": ["--test"],
      "required": true,
      "dependsOn": [],
      "pathPrefixes": []
    },
    {
      "id": "typecheck",
      "executable": "pnpm",
      "args": ["exec", "tsc", "-p", "tsconfig.json"],
      "required": true,
      "dependsOn": [],
      "pathPrefixes": []
    },
    {
      "id": "format_check",
      "executable": "pnpm",
      "args": ["exec", "prettier", "--check", "."],
      "required": true,
      "dependsOn": [],
      "pathPrefixes": []
    }
  ],
  "limits": {
    "maxDiffLines": 2000,
    "maxDiffBytes": 409600,
    "logMaxBytes": 5242880,
    "evidenceTailLines": 200,
    "defaultMaxIterations": 2,
    "maxCycleCostRub": 30
  },
  "paths": {
    "prTemplate": ".github/PULL_REQUEST_TEMPLATE.md"
  },
  "gateTimeouts": {
    "test": 600000,
    "format_check": 120000,
    "typecheck": 180000
  }
}
